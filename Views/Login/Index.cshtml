
@{
    Layout = null;
}

@model AcunMedya.Cafe.Entities.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Login</title>
    <link rel="stylesheet" href="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/css/style.css" />
</head>
<body>
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth">
                <div class="row flex-grow">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left p-5">
                            <div class="brand-logo">
                                <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/Nar.svg" />
                            </div>
                            <h4>Hoş geldiniz!</h4>
                            <h6 class="font-weight-light">Giriş yaparak devam edin</h6>

                            <form asp-action="Index" method="post" class="pt-3">
                                <div class="form-group">
                                    <input asp-for="UserName" class="form-control form-control-lg" placeholder="Kullanıcı Adı" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                  
                                </div>
                                <div class="form-group">
                                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Şifre" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="mt-3 d-grid">
                                    <button type="submit" class="btn btn-block btn-gradient-primary btn-lg font-weight-medium auth-form-btn">
                                        Giriş Yap
                                    </button>
                                </div>
                            </form>

                        

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/vendors/js/vendor.bundle.base.js"></script>
</body>
</html>
